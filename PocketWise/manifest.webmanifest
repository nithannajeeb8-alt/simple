{
  "id": "./",
  "name": "Pocketwise · Money, made clearer",
  "short_name": "Pocketwise",
  "description": "Offline-first personal finance tracker with reviewed payment imports.",
  "lang": "en-IN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": [
    "finance",
    "utilities"
  ],
  "icons": [
    {
      "src": "assets/icons/icon-192.PNG",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-192.PNG",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon-512.PNG",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.PNG",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "description": "Open Quick Add for an expense",
      "url": "./?quickadd=expense",
      "icons": [
        {
          "src": "assets/icons/icon-192.PNG",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "description": "Open Quick Add for income",
      "url": "./?quickadd=income",
      "icons": [
        {
          "src": "assets/icons/icon-192.PNG",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Debts and lending",
      "short_name": "Debts",
      "description": "Open debts and lending",
      "url": "./?quickadd=debt",
      "icons": [
        {
          "src": "assets/icons/icon-192.PNG",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "images",
          "accept": [
            "image/*",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp",
            ".heic",
            ".heif"
          ]
        }
      ]
    }
  }
}
