{
  "id": "./",
  "name": "Pocketwise \u00b7 Money, made clearer",
  "short_name": "Pocketwise",
  "description": "Offline-first personal finance tracker with reviewed payment imports.",
  "lang": "en-IN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#103b2d",
  "theme_color": "#103b2d",
  "categories": [
    "finance",
    "utilities"
  ],
  "icons": [
    {
      "src": "assets/icons/icon-192.PNG",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-192.PNG",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "assets/icons/icon-512.PNG",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512.PNG",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "description": "Open Quick Add for an expense",
      "url": "./?quickadd=expense",
      "icons": [
        {
          "src": "assets/icons/icon-192.PNG",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "description": "Open Quick Add for income",
      "url": "./?quickadd=income",
      "icons": [
        {
          "src": "assets/icons/icon-192.PNG",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Debts and lending",
      "short_name": "Debts",
      "description": "Open debts and lending",
      "url": "./?quickadd=debt",
      "icons": [
        {
          "src": "assets/icons/icon-192.PNG",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  }
}
