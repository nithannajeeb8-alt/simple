{
  "id": "./",
  "name": "Pocketwise · Money, made clearer",
  "short_name": "Pocketwise",
  "description": "A private, offline-first personal finance companion.",
  "lang": "en-IN",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
