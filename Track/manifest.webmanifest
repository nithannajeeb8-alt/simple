{
  "id": "/Track/",
  "name": "Pocketwise \u00b7 Track your money",
  "short_name": "Track",
  "description": "A private, offline-first personal finance companion.",
  "lang": "en-IN",
  "start_url": "/Track/",
  "scope": "/Track/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#f4f6fb",
  "theme_color": "#172c63",
  "categories": [
    "finance",
    "utilities"
  ],
  "icons": [
    {
      "src": "/Track/assets/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/Track/assets/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/Track/assets/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Add expense",
      "short_name": "Expense",
      "description": "Open Quick Add for an expense",
      "url": "/Track/?quickadd=expense",
      "icons": [
        {
          "src": "/Track/assets/icons/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Add income",
      "short_name": "Income",
      "description": "Open Quick Add for income",
      "url": "/Track/?quickadd=income",
      "icons": [
        {
          "src": "/Track/assets/icons/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Debts and lending",
      "short_name": "Debts",
      "description": "Open debts and lending",
      "url": "/Track/?quickadd=debt",
      "icons": [
        {
          "src": "/Track/assets/icons/icon.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ],
  "version": "5.0.0"
}
